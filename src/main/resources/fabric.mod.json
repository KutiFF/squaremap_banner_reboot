{
  "schemaVersion": 1,
  "id": "squaremap-banner",
  "version": "${version}",
  "name": "SquareMap Banner Reboot",
  "description": "A community-maintained continuation of the original SquareMap Banner project.",
  "authors": [
    {
      "name": "FaeWulf",
      "contact":{
        "homepage": "https://github.com/FaeWulf"
      }
    },
    {
      "name": "KutiFF",
      "contact": {
        "homepage": "https://github.com/KutiFF"
      }
    }
  ],
  "contributors": [
    {
      "name": "Acuadragon100",
      "contact": {
        "homepage": "https://github.com/Acuadragon100"
      }
    }
  ],
  "contact": {
    "sources": "https://github.com/KutiFF/squaremap_banner_reboot",
    "issues": "https://github.com/KutiFF/squaremap_banner_reboot/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/squaremap-banner/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "faewulf.squaremap.banner.Squaremapbanner"
